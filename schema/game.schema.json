{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simgrammar.dev/schema/1.0/game.schema.json",
  "title": "Game",
  "description": "A simulation game (or boundary case included for its mechanics). Owns `uses` edges to mechanics and `influenced_by` edges to earlier games.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "summary", "year", "developer", "platforms", "subgenre", "sim_domain", "player_role", "agency_model", "time_model", "sim_scale", "fidelity", "perspective", "win_structure", "failure_model", "narrative_mode", "multiplayer", "modding", "production_tier", "agent_count_order", "emergence", "influence", "core_loop", "mechanics", "status", "provenance"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "type": { "const": "game" },
    "name": { "$ref": "common.schema.json#/$defs/name" },
    "aliases": { "$ref": "common.schema.json#/$defs/aliases" },
    "summary": { "$ref": "common.schema.json#/$defs/summary" },
    "year": { "$ref": "common.schema.json#/$defs/year", "description": "First public release, including early access." },
    "year_full_release": { "$ref": "common.schema.json#/$defs/year", "description": "1.0 release year when it differs from `year`." },
    "developer": { "type": "string", "minLength": 1, "maxLength": 200 },
    "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "x-vocab": "platform" } },
    "subgenre": { "type": "string", "x-vocab": "subgenre" },
    "subgenre_secondary": { "type": "array", "uniqueItems": true, "maxItems": 3, "items": { "type": "string", "x-vocab": "subgenre" } },
    "sim_domain": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "x-vocab": "sim_domain" } },
    "player_role": { "type": "string", "x-vocab": "player_role" },
    "agency_model": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "x-vocab": "agency_model" } },
    "time_model": { "type": "string", "x-vocab": "time_model" },
    "sim_scale": { "type": "string", "x-vocab": "sim_scale" },
    "fidelity": { "type": "string", "x-vocab": "fidelity" },
    "perspective": { "type": "string", "x-vocab": "perspective" },
    "win_structure": { "type": "string", "x-vocab": "win_structure" },
    "failure_model": { "type": "string", "x-vocab": "failure_model" },
    "narrative_mode": { "type": "string", "x-vocab": "narrative_mode" },
    "multiplayer": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "x-vocab": "multiplayer" } },
    "modding": { "type": "string", "x-vocab": "modding" },
    "production_tier": { "type": "string", "x-vocab": "production_tier" },
    "agent_count_order": { "type": "string", "x-vocab": "agent_count_order" },
    "emergence": { "$ref": "common.schema.json#/$defs/score", "x-rubric": "emergence" },
    "influence": { "$ref": "common.schema.json#/$defs/score", "x-rubric": "influence" },
    "boundary_case": { "type": "boolean", "description": "True when the game is not primarily a simulation but is included for specific mechanics." },
    "core_loop": { "type": "string", "minLength": 20, "maxLength": 400, "description": "Arrow-separated loop: 'zone land -> citizens arrive -> demand shifts -> tax income -> expand'." },
    "design_notes": { "$ref": "common.schema.json#/$defs/text" },
    "mechanics": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id", "x-edge": "uses" },
          "role": { "type": "string", "x-vocab": "mechanic_role" },
          "note": { "type": "string", "minLength": 5, "maxLength": 500, "description": "How this game implements the mechanic. Required for core mechanics." }
        }
      }
    },
    "influenced_by": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id", "x-edge": "influenced_by" } },
    "claims": { "$ref": "common.schema.json#/$defs/claims" },
    "sources": { "$ref": "common.schema.json#/$defs/sources" },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "deprecated": { "$ref": "common.schema.json#/$defs/deprecated" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  }
}
